{
  "name": "elements-launcher",
  "productName": "Elements Launcher",
  "private": true,
  "version": "1.0.7",
  "description": "Central de aplicativos do Elements — baixe, instale e gerencie seus apps em um só lugar.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc && vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis portable --x64",
    "release": "npm run dist && node scripts/release.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.15.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "build": {
    "appId": "com.elements.launcher",
    "productName": "Elements Launcher",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "geebe-es",
      "repo": "elements-launcher"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Elements-Launcher-Setup.exe"
    },
    "portable": {
      "artifactName": "Elements-Launcher-Portable.exe"
    }
  }
}
